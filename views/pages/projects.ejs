<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container text-center">
    <span class="section-tag" data-aos="fade-up">Projects</span>
    <h1 class="page-title section-title-gradient" data-aos="fade-up">My Work</h1>
    <p class="lead" data-aos="fade-up">A collection of projects I've built</p>
    <form action="/projects" method="GET" class="search-form mt-4" data-aos="fade-up">
      <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Search projects..." value="<%= search %>">
        <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i></button>
      </div>
    </form>
  </div>
</section>

<section class="section-padding">
  <div class="container">
    <% if (projects && projects.length) { %>
      <div class="row g-4">
        <% projects.forEach((project, i) => { %>
          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= (i % 6) * 50 %>">
            <div class="project-card h-100 tilt-card">
              <div class="project-image">
                <% if (project.image) { %>
                  <img src="<%= project.image %>" alt="<%= project.title %>">
                <% } else { %>
                  <div class="project-placeholder"><i class="fas fa-laptop-code"></i></div>
                <% } %>
                <div class="project-overlay">
                  <% if (project.liveLink) { %>
                    <a href="<%= project.liveLink %>" target="_blank" rel="noopener" class="btn btn-sm btn-light"><i class="fas fa-external-link-alt"></i></a>
                  <% } %>
                  <% if (project.githubLink) { %>
                    <a href="<%= project.githubLink %>" target="_blank" rel="noopener" class="btn btn-sm btn-light"><i class="fab fa-github"></i></a>
                  <% } %>
                </div>
              </div>
              <div class="project-body">
                <h5><%= project.title %></h5>
                <p><%= project.description %></p>
                <div class="tech-badges mb-3">
                  <% project.technologies.split(',').forEach(tech => { %>
                    <span class="badge"><%= tech.trim() %></span>
                  <% }) %>
                </div>
                <div class="project-links">
                  <% if (project.githubLink) { %>
                    <a href="<%= project.githubLink %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-light">
                      <i class="fab fa-github me-1"></i>GitHub
                    </a>
                  <% } %>
                  <% if (project.liveLink) { %>
                    <a href="<%= project.liveLink %>" target="_blank" rel="noopener" class="btn btn-sm btn-primary">
                      <i class="fas fa-external-link-alt me-1"></i>Live Demo
                    </a>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state text-center" data-aos="fade-up">
        <i class="fas fa-folder-open fa-3x mb-3 text-muted"></i>
        <h4><%= search ? 'No projects match your search' : 'No projects yet' %></h4>
        <p class="text-muted">Projects will appear here once added from the admin panel.</p>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
