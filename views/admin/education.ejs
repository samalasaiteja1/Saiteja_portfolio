<%- include('../partials/admin-layout-start') %>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="glass-card p-4">
      <h5 class="mb-3"><i class="fas fa-graduation-cap me-2"></i>Add Education</h5>
      <form action="/admin/education" method="POST">
        <div class="mb-3">
          <label class="form-label">Degree</label>
          <input type="text" name="degree" class="form-control" placeholder="e.g. Bachelor of Technology" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Field of Study</label>
          <input type="text" name="fieldOfStudy" class="form-control" placeholder="e.g. Computer Science / IT" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Institution</label>
          <input type="text" name="institution" class="form-control" placeholder="e.g. Mumbai University" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Duration</label>
          <input type="text" name="duration" class="form-control" placeholder="e.g. 2019 - 2023" required>
        </div>
        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-plus me-1"></i>Add Education</button>
      </form>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="glass-card p-4">
      <h5 class="mb-3">All Education Details (<%= education.length %>)</h5>
      <div class="table-responsive">
        <table class="table table-dark table-hover admin-table">
          <thead>
            <tr>
              <th>Degree</th>
              <th>Field of Study</th>
              <th>Institution</th>
              <th>Duration</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% education.forEach(edu => { %>
              <tr>
                <td class="fw-bold text-accent"><%= edu.degree %></td>
                <td><%= edu.fieldOfStudy %></td>
                <td><%= edu.institution %></td>
                <td><span class="badge bg-accent-soft"><%= edu.duration %></span></td>
                <td>
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editEdu<%= edu._id %>"><i class="fas fa-edit"></i></button>
                  <form action="/admin/education/<%= edu._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this education detail?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
            <% if (!education.length) { %>
              <tr><td colspan="5" class="text-center text-muted">No education details added yet</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% education.forEach(edu => { %>
<div class="modal fade" id="editEdu<%= edu._id %>" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title">Edit Education Detail</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/education/<%= edu._id %>?_method=PUT" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Degree</label>
            <input type="text" name="degree" class="form-control" value="<%= edu.degree %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Field of Study</label>
            <input type="text" name="fieldOfStudy" class="form-control" value="<%= edu.fieldOfStudy %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Institution</label>
            <input type="text" name="institution" class="form-control" value="<%= edu.institution %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Duration</label>
            <input type="text" name="duration" class="form-control" value="<%= edu.duration %>" required>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Update Details</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% }) %>

<%- include('../partials/admin-layout-end') %>
