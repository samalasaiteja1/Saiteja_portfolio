<%- include('../partials/admin-layout-start') %>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="glass-card p-4">
      <h5 class="mb-3"><i class="fas fa-plus-circle me-2"></i>Add Certification</h5>
      <form action="/admin/certifications" method="POST" enctype="multipart/form-data">
        <div class="mb-3"><input type="text" name="title" class="form-control" placeholder="Certification Title" required></div>
        <div class="mb-3"><input type="text" name="organization" class="form-control" placeholder="Organization" required></div>
        <div class="mb-3"><input type="text" name="issueDate" class="form-control" placeholder="Issue Date (e.g. Jan 2024)" required></div>
        <div class="mb-3"><input type="url" name="certificateLink" class="form-control" placeholder="Certificate Link"></div>
        <div class="mb-3">
          <label class="form-label">Certificate Image</label>
          <input type="file" name="certificateImage" class="form-control" accept="image/*">
        </div>
        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-plus me-1"></i>Add Certification</button>
      </form>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="glass-card p-4">
      <h5 class="mb-3">All Certifications (<%= certifications.length %>)</h5>
      <div class="table-responsive">
        <table class="table table-dark table-hover admin-table">
          <thead>
            <tr><th>Image</th><th>Title</th><th>Organization</th><th>Date</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% certifications.forEach(cert => { %>
              <tr>
                <td><% if (cert.certificateImage) { %><img src="<%= cert.certificateImage %>" class="table-thumb" alt=""><% } else { %>—<% } %></td>
                <td><%= cert.title %></td>
                <td><%= cert.organization %></td>
                <td><%= cert.issueDate %></td>
                <td>
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editCert<%= cert._id %>"><i class="fas fa-edit"></i></button>
                  <form action="/admin/certifications/<%= cert._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
            <% if (!certifications.length) { %>
              <tr><td colspan="5" class="text-center text-muted">No certifications yet</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% certifications.forEach(cert => { %>
<div class="modal fade" id="editCert<%= cert._id %>" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title">Edit Certification</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/certifications/<%= cert._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="mb-3"><input type="text" name="title" class="form-control" value="<%= cert.title %>" required></div>
          <div class="mb-3"><input type="text" name="organization" class="form-control" value="<%= cert.organization %>" required></div>
          <div class="mb-3"><input type="text" name="issueDate" class="form-control" value="<%= cert.issueDate %>" required></div>
          <div class="mb-3"><input type="url" name="certificateLink" class="form-control" value="<%= cert.certificateLink %>"></div>
          <div class="mb-3"><label class="form-label">New Image (optional)</label><input type="file" name="certificateImage" class="form-control" accept="image/*"></div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% }) %>

<%- include('../partials/admin-layout-end') %>
