<%- include('../partials/admin-layout-start') %>
<div class="row g-4 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="stat-card glass-card">
      <div class="stat-icon bg-primary-soft"><i class="fas fa-code"></i></div>
      <div>
        <h3><%= stats.skillsCount %></h3>
        <p>Total Skills</p>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="stat-card glass-card">
      <div class="stat-icon bg-success-soft"><i class="fas fa-project-diagram"></i></div>
      <div>
        <h3><%= stats.projectsCount %></h3>
        <p>Total Projects</p>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="stat-card glass-card">
      <div class="stat-icon bg-warning-soft"><i class="fas fa-certificate"></i></div>
      <div>
        <h3><%= stats.certificationsCount %></h3>
        <p>Certifications</p>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="stat-card glass-card">
      <div class="stat-icon bg-info-soft"><i class="fas fa-envelope"></i></div>
      <div>
        <h3><%= stats.messagesCount %></h3>
        <p>Messages</p>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="glass-card p-4 h-100">
      <h5 class="mb-4"><i class="fas fa-envelope me-2"></i>Recent Contact Messages</h5>
      <div class="table-responsive">
        <table class="table table-dark table-hover admin-table mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Subject</th>
              <th>Message</th>
              <th>Date</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentMessages && recentMessages.length) { %>
              <% recentMessages.forEach(msg => { %>
                <tr>
                  <td><%= msg.name %></td>
                  <td><%= msg.email %></td>
                  <td><%= msg.subject %></td>
                  <td class="text-truncate" style="max-width: 150px;" title="<%= msg.message %>"><%= msg.message %></td>
                  <td><%= new Date(msg.createdAt).toLocaleDateString() %></td>
                  <td class="text-end">
                    <form action="/admin/messages/delete/<%= msg._id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this message?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="6" class="text-center text-muted">No messages yet</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="glass-card p-4 h-100">
      <h5 class="mb-4"><i class="fas fa-file-pdf me-2 text-danger"></i>Resume Management</h5>
      <% if (admin && admin.resumeUrl) { %>
        <div class="text-center py-4">
          <div class="mb-3 text-success">
            <i class="fas fa-check-circle fa-3x"></i>
          </div>
          <p class="mb-4 text-muted small">A professional resume is currently uploaded and active on your website.</p>
          <div class="d-grid gap-2">
            <a href="<%= admin.resumeUrl %>" target="_blank" class="btn btn-outline-light btn-glow-outline">
              <i class="fas fa-eye me-2"></i>View Resume
            </a>
            <a href="/resume/download" class="btn btn-outline-light btn-glow-outline" download="SAMALA_SAITEJA.pdf">
              <i class="fas fa-download me-2"></i>Download Resume
            </a>
            <form action="/admin/resume/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete the uploaded resume?')">
              <button type="submit" class="btn btn-danger w-100">
                <i class="fas fa-trash me-2"></i>Delete Resume
              </button>
            </form>
          </div>
        </div>
      <% } else { %>
        <div class="py-2">
          <p class="text-muted small mb-4">No resume is currently uploaded. The "Download Resume" buttons on the public website are hidden until you upload a resume.</p>
          <form action="/admin/resume/upload" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label small text-muted">Select Resume (PDF only)</label>
              <input type="file" name="resume" class="form-control" accept="application/pdf" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">
              <i class="fas fa-upload me-2"></i>Upload Resume
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/admin-layout-end') %>
