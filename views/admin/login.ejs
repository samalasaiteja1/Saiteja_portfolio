<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | Portfolio</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="admin-login-body">
  <div class="login-container">
    <div class="login-card glass-card">
      <div class="text-center mb-4">
        <img src="<%= site.profileImage %>" alt="Admin" class="admin-profile-img mb-3">
        <h3>Admin Login</h3>
        <p class="text-muted">Sign in to manage your portfolio</p>
      </div>
      <% if (error_msg && error_msg.length) { %>
        <div class="alert alert-danger"><%= error_msg[0] %></div>
      <% } %>
      <% if (success_msg && success_msg.length) { %>
        <div class="alert alert-success"><%= success_msg[0] %></div>
      <% } %>
      <form action="/admin/login" method="POST">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" placeholder="admin@portfolio.com" required>
        </div>
        <div class="mb-4">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" placeholder="Enter password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-glow w-100">
          <i class="fas fa-sign-in-alt me-2"></i>Login
        </button>
      </form>
      <div class="text-center mt-4">
        <a href="/" class="text-muted"><i class="fas fa-arrow-left me-1"></i>Back to Website</a>
      </div>
    </div>
  </div>
</body>
</html>
